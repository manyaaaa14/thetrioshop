# THE TRIO SHOP — environment variables
# Payment configuration for Google Pay / PhonePe / Paytm / UPI orders
VITE_PAYMENT_UPI_ID=9729794568@fam
PAYMENT_UPI_ID=9729794568@fam
VITE_API_BASE_URL=https://thetrioshopp.onrender.com

# Example values:
# VITE_API_BASE_URL=https://thetrioshop.netlify.app
# VITE_PAYMENT_UPI_ID=9729794568@fam
# PAYMENT_UPI_ID=9729794568@fam
#
# Any variable exposed to the frontend MUST be prefixed with VITE_ and
# accessed in code as import.meta.env.VITE_YOUR_VAR. Never put secret keys
# (server-only API keys, DB credentials) in this file — those belong on
# your backend server, not in the frontend bundle.
