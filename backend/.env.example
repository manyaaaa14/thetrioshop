# BLORA backend environment variables

# Server
PORT=5001
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=https://bloraa.netlify.app

# MongoDB Atlas connection string. Keep credentials private.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# Project ID used to validate Firebase Authentication tokens.
FIREBASE_PROJECT_ID=

# Direct UPI QR payments
PAYMENT_UPI_ID=manishataneja980@oksbi
